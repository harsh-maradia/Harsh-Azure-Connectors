{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "FunctionName": {
      "type": "string",
      "defaultValue": "Censys",
      "metadata": {
        "description": "Name prefix of the Function App to create (up to 10 characters, letters and digits)."
      },
      "minLength": 1,
      "maxLength": 10
    },
    "CensysApiToken": {
      "type": "securestring",
      "metadata": {
        "description": "Censys personal access token. Starter, Search and Core plans need the API Access role."
      }
    },
    "OrganizationId": {
      "type": "string",
      "metadata": {
        "description": "UUID of the Censys organization to collect risk events for."
      }
    },
    "InitialStartTime": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. UTC time to start collecting from, for example 2026-10-01T00:00:00Z. Leave empty to start from 1970-01-01T00:00:00Z (all events Censys still retains)."
      }
    },
    "SupplierIds": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Comma-separated Censys supplier UUIDs. Leave empty for all suppliers."
      }
    },
    "ChangeTypes": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Comma-separated change types: opened, resolved, reopened. Leave empty for all."
      }
    },
    "Severity": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Comma-separated severities: CRITICAL, HIGH, MEDIUM, LOW. Leave empty for all."
      }
    },
    "RapidResponse": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. true for rapid response findings only, false to exclude them. Leave empty for both."
      },
      "allowedValues": [
        "",
        "true",
        "false"
      ]
    },
    "Azure_Client_Id": {
      "type": "string",
      "metadata": {
        "description": "Enter Azure Client Id of the Microsoft Entra app used to ingest data. It is the app you created for this connector."
      }
    },
    "Azure_Client_Secret": {
      "type": "securestring",
      "metadata": {
        "description": "Enter the client secret that you created for that Microsoft Entra app."
      }
    },
    "Azure_Tenant_Id": {
      "type": "string",
      "metadata": {
        "description": "Enter Azure Tenant Id of your Microsoft Entra ID."
      }
    },
    "Azure_Entra_Object_Id": {
      "type": "string",
      "metadata": {
        "description": "Enter the Object Id of your Microsoft Entra app (Enterprise application). It gets the Monitoring Metrics Publisher role on the data collection rule."
      }
    },
    "Schedule": {
      "type": "string",
      "defaultValue": "0 */30 * * * *",
      "metadata": {
        "description": "Quartz (NCRONTAB) cron expression for how often the function runs. Default is every 30 minutes."
      }
    },
    "WorkspaceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Workspace ID (GUID) of the Log Analytics workspace where the Censys CCF connector is deployed. Found on the workspace Overview page. The data collection rule and endpoint of that connector are located from it."
      }
    },
    "Table_Name": {
      "type": "string",
      "defaultValue": "CensysRiskEvents",
      "metadata": {
        "description": "Name of the table the data collection rule writes to, without the _CL suffix. The stream name is Custom-<Table_Name>_CL. Please do not keep this field as empty else you will get validation error."
      }
    },
    "AppInsightsWorkspaceResourceID": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Log Analytics workspace used by Application Insights. Use 'Log Analytics Workspace, Properties' blade, Resource ID."
      }
    },
    "LogLevel": {
      "type": "string",
      "defaultValue": "INFO",
      "metadata": {
        "description": "Log level of the function."
      },
      "allowedValues": [
        "DEBUG",
        "INFO",
        "ERROR"
      ]
    }
  },
  "variables": {
    "FunctionName": "[concat(toLower(parameters('FunctionName')), uniqueString(resourceGroup().id))]",
    "deploymentStorageContainerName": "[concat('app-package-', toLower(parameters('FunctionName')))]",
    "storageBlobDataOwnerRoleId": "b7e6dc6d-f1e8-4753-8033-0f276bb0955b",
    "monitoringMetricsPublisherRoleId": "3913510d-42f4-4e42-8a64-420c390055eb",
    "scope": "[concat(replace(environment().portal, 'portal', 'monitor'), '/.default')]",
    "dcrId": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName'))]",
    "dcrName": "[concat('Microsoft-Sentinel-CensysRiskEventsDCR-', take(parameters('WorkspaceId'), 12))]",
    "dceName": "[concat('ASI-', parameters('WorkspaceId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "ApplicationId": "[variables('FunctionName')]",
        "WorkspaceResourceId": "[parameters('AppInsightsWorkspaceResourceID')]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[tolower(variables('FunctionName'))]",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "Standard_LRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "networkAcls": {
          "bypass": "AzureServices",
          "virtualNetworkRules": [],
          "ipRules": [],
          "defaultAction": "Allow"
        },
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "encryption": {
          "services": {
            "file": {
              "keyType": "Account",
              "enabled": true
            },
            "blob": {
              "keyType": "Account",
              "enabled": true
            }
          },
          "keySource": "Microsoft.Storage"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-01-01",
      "name": "[concat(tolower(variables('FunctionName')), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName')))]"
      ],
      "properties": {
        "cors": {
          "corsRules": []
        },
        "deleteRetentionPolicy": {
          "enabled": false
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(tolower(variables('FunctionName')), '/default/', variables('deploymentStorageContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', tolower(variables('FunctionName')), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(tolower(variables('FunctionName')), '/default/', 'azure-webjobs-hosts')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', tolower(variables('FunctionName')), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(tolower(variables('FunctionName')), '/default/', 'azure-webjobs-secrets')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', tolower(variables('FunctionName')), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "functionapp",
      "sku": {
        "tier": "FlexConsumption",
        "name": "FC1"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('FunctionName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', tolower(variables('FunctionName')), 'default', variables('deploymentStorageContainerName'))]",
        "[resourceId('Microsoft.Insights/components', variables('FunctionName'))]"
      ],
      "properties": {
        "name": "[variables('FunctionName')]",
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('FunctionName'))]",
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[concat(reference(resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName')))).primaryEndpoints.blob, variables('deploymentStorageContainerName'))]",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": 40,
            "instanceMemoryMB": 2048
          },
          "runtime": {
            "name": "python",
            "version": "3.14"
          }
        }
      },
      "resources": [
        {
          "apiVersion": "2023-12-01",
          "type": "config",
          "name": "appsettings",
          "dependsOn": [
            "[concat('Microsoft.Web/sites/', variables('FunctionName'))]"
          ],
          "properties": {
            "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionName')), '2015-05-01').InstrumentationKey]",
            "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionName')), '2015-05-01').ConnectionString]",
            "AzureWebJobsStorage": "[concat('DefaultEndpointsProtocol=https;AccountName=', tolower(variables('FunctionName')), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName'))), '2023-01-01').keys[0].value, ';EndpointSuffix=', environment().suffixes.storage)]",
            "CensysApiToken": "[parameters('CensysApiToken')]",
            "OrganizationId": "[parameters('OrganizationId')]",
            "InitialStartTime": "[parameters('InitialStartTime')]",
            "SupplierIds": "[parameters('SupplierIds')]",
            "ChangeTypes": "[parameters('ChangeTypes')]",
            "Severity": "[parameters('Severity')]",
            "RapidResponse": "[parameters('RapidResponse')]",
            "Schedule": "[parameters('Schedule')]",
            "LogLevel": "[parameters('LogLevel')]",
            "StreamName": "[concat('Custom-', parameters('Table_Name'), '_CL')]",
            "SCOPE": "[variables('scope')]",
            "AZURE_DATA_COLLECTION_ENDPOINT": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2023-03-11').logsIngestion.endpoint]",
            "AZURE_DATA_COLLECTION_RULE_ID": "[reference(variables('dcrId'), '2023-03-11').immutableId]",
            "AZURE_CLIENT_ID": "[parameters('Azure_Client_Id')]",
            "AZURE_CLIENT_SECRET": "[parameters('Azure_Client_Secret')]",
            "AZURE_TENANT_ID": "[parameters('Azure_Tenant_Id')]"
          }
        }
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName'))), variables('storageBlobDataOwnerRoleId'), variables('FunctionName'))]",
      "scope": "[concat('Microsoft.Storage/storageAccounts', '/', tolower(variables('FunctionName')))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName')))]",
        "[resourceId('Microsoft.Web/sites', variables('FunctionName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataOwnerRoleId'))]",
        "principalType": "ServicePrincipal",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('FunctionName')), '2023-12-01', 'Full').identity.principalId]"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('dcrId'), variables('monitoringMetricsPublisherRoleId'), parameters('Azure_Entra_Object_Id'))]",
      "scope": "[variables('dcrId')]",
      "dependsOn": [],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringMetricsPublisherRoleId'))]",
        "principalType": "ServicePrincipal",
        "principalId": "[parameters('Azure_Entra_Object_Id')]"
      }
    },
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2020-10-01",
      "name": "WaitSection",
      "location": "[resourceGroup().location]",
      "kind": "AzurePowerShell",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('FunctionName'))]",
        "[guid(resourceId('Microsoft.Storage/storageAccounts', tolower(variables('FunctionName'))), variables('storageBlobDataOwnerRoleId'), variables('FunctionName'))]"
      ],
      "properties": {
        "azPowerShellVersion": "7.0",
        "scriptContent": "start-sleep -Seconds 30",
        "cleanupPreference": "Always",
        "retentionInterval": "PT1H"
      }
    },
    {
      "type": "Microsoft.Web/sites/extensions",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}/{1}', variables('FunctionName'), 'onedeploy')]",
      "dependsOn": [
        "WaitSection"
      ],
      "properties": {
        "packageUri": "https://github.com/harsh-maradia/Harsh-Azure-Connectors/raw/refs/heads/main/Censys-RiskEvents-1.0.0/CensysRiskEvents.zip",
        "remoteBuild": true
      }
    }
  ],
  "outputs": {
    "FunctionAppName": {
      "type": "string",
      "value": "[variables('FunctionName')]"
    }
  }
}
